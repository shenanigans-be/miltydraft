{
    skip_install_trust
    frankenphp
}

:80, milty.localhost {
    root * /code

    log {
        output stdout
    }

    header {
        X-Frame-Options DENY
        Referrer-Policy no-referrer-when-downgrade
        Access-Control-Allow-Origin *
    }

    @options method OPTIONS
    respond @options 204

    @svg {
        file
        path *.svg
    }

    header @svg Content-Security-Policy "script-src 'none'"

    encode zstd br gzip
    php_server
}
